# Evidence 37 — the as-of price read becomes one indexed LIMIT 1 per entry (decision log Impl-2 #36, decision 1)
# Branch impl-2, local Docker Postgres 16 on 127.0.0.1:55432, 2026-11-07. Follows evidence 36.
# Change: src/modules/catalog/infra/pg.ts `latestObservations` (CAT-owned table, CAT's own adapter, AD-8 unchanged).
# No migration: `reference_price_as_of` ("catalogEntryId", "observedAt" DESC, source, id) already exists (001 schema),
# and it is exactly the LIMIT 1 walk's order. Same semantics (AD-CAT-2): the latest observation at or before asOf, ties by
# source then id, and no row (no price) for an entry with none.

# ----- The query, before -----
SELECT DISTINCT ON ("catalogEntryId") "catalogEntryId", <observed columns> FROM "ReferencePriceObservation"
 WHERE "catalogEntryId" = ANY($1) AND "observedAt" <= $2 ORDER BY "catalogEntryId", "observedAt" DESC, source, id
# ----- The query, after -----
SELECT e.id AS "catalogEntryId", <observed columns>
  FROM (SELECT DISTINCT unnest($1::text[]) AS id) e
  CROSS JOIN LATERAL (
    SELECT * FROM "ReferencePriceObservation" r
     WHERE r."catalogEntryId" = e.id AND r."observedAt" <= $2
     ORDER BY r."observedAt" DESC, r.source, r.id LIMIT 1
  ) o

# ===== Same answer (both statements on the seed, a temporary probe in val2_latency.test.ts, reverted) =====
