{
  "name": "tezg",
  "private": true,
  "version": "0.0.0",
  "description": "TEZG — Solu red-phase harness: interface stubs, DTOs and ATDD suites. No production logic (Solutioning stop-point).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test:schema:solu1": "vitest run --project solu1-schema",
    "test:atdd:solu1": "vitest run --project solu1-atdd",
    "gate:atdd-red:solu1": "node scripts/check-atdd-red.mjs solu1-atdd 131 --status docs/solu-1/implementation-artifacts/sprint-status.yaml --epics docs/solu-1/planning/epics.md",
    "gate:codes:solu1": "node scripts/check-code-citations.mjs docs/solu-1/planning/contracts.md",
    "gate:solu1": "npm run typecheck && npm run test:schema:solu1 && npm run gate:atdd-red:solu1 && npm run gate:codes:solu1",
    "gen:api:solu2": "node scripts/gen-solu2-api.mjs",
    "test:fitness:solu2": "vitest run --project solu2-fitness",
    "gate:api:solu2": "node scripts/gen-solu2-api.mjs --check",
    "gate:codes:solu2": "node scripts/check-code-citations.mjs docs/solu-2/planning/detailed-design/contracts.md",
    "gate:atdd-red:solu2": "node scripts/check-atdd-red.mjs solu2-atdd 352",
    "gate:nfr-red:solu2": "node scripts/check-atdd-red.mjs solu2-nfr 3",
    "gate:purity": "node scripts/check-domain-purity.mjs",
    "gate:ui:solu2": "node scripts/check-ui-states.mjs --check",
    "gate:ids:solu2": "node scripts/check-test-ids.mjs",
    "gen:trace:solu2": "node scripts/gen-solu2-trace.mjs",
    "gate:trace:solu2": "node scripts/gen-solu2-trace.mjs --check",
    "gate:solu2": "npm run typecheck && npm run gate:api:solu2 && npm run gate:ui:solu2 && npm run gate:codes:solu2 && npm run gate:ids:solu2 && npm run gate:trace:solu2 && npm run gate:purity && npm run test:fitness:solu2 && npm run gate:atdd-red:solu2 && npm run gate:nfr-red:solu2"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
