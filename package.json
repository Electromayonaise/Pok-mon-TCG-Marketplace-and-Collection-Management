{
  "name": "tezg",
  "private": true,
  "version": "0.0.0",
  "description": "TEZG — Pokémon TCG marketplace and collection tracker: a Next.js 16 + tRPC API over PostgreSQL 16 (Impl-1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate && npm --prefix tools/lint ci --no-audit --no-fund",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/db-migrate.mjs --reset",
    "db:pull": "node scripts/gen-prisma-schema.mjs && prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "test:lint-rules": "node --test tools/lint/tezg-plugin.test.mjs",
    "test:unit": "vitest run --project impl1-unit",
    "gate:deps": "node scripts/check-deps.mjs",
    "gate:prisma": "node scripts/gen-prisma-schema.mjs --check",
    "test": "npm run db:up && npm run test:ci",
    "test:ci": "npm run lint && npm run gate:deps && npm run gate:prisma && npm run test:unit && npm run gate:impl1",
    "gen:api:solu2": "node scripts/gen-solu2-api.mjs",
    "test:fitness:solu2": "vitest run --project solu2-fitness",
    "gate:api:solu2": "node scripts/gen-solu2-api.mjs --check",
    "gate:codes:solu2": "node scripts/check-code-citations.mjs _bmad-output/planning-artifacts/detailed-design/contracts.md",
    "gate:atdd-red:solu2": "node scripts/check-atdd-red.mjs solu2-atdd 352 --status _bmad-output/implementation-artifacts/sprint-status.yaml --epics _bmad-output/planning-artifacts/epics.md",
    "gate:nfr-red:solu2": "node scripts/check-atdd-red.mjs solu2-nfr 3",
    "gate:purity": "node scripts/check-domain-purity.mjs",
    "gate:ui:solu2": "node scripts/check-ui-states.mjs --check",
    "gate:ids:solu2": "node scripts/check-test-ids.mjs",
    "gen:trace:solu2": "node scripts/gen-solu2-trace.mjs",
    "gate:trace:solu2": "node scripts/gen-solu2-trace.mjs --check",
    "gen:epics:solu2": "node scripts/gen-solu2-epics.mjs",
    "gate:epics:solu2": "node scripts/gen-solu2-epics.mjs --check",
    "gate:solu2": "npm run typecheck && npm run gate:api:solu2 && npm run gate:ui:solu2 && npm run gate:codes:solu2 && npm run gate:ids:solu2 && npm run gate:trace:solu2 && npm run gate:epics:solu2 && npm run gate:purity && npm run test:fitness:solu2 && npm run gate:atdd-red:solu2 && npm run gate:nfr-red:solu2",
    "gate:atdd-red:impl1": "node scripts/check-atdd-red.mjs solu2-atdd 352 --status _bmad-output/implementation-artifacts/sprint-status.yaml --epics _bmad-output/planning-artifacts/epics.md",
    "gate:nfr-red:impl1": "node scripts/check-atdd-red.mjs solu2-nfr 3 --status _bmad-output/implementation-artifacts/sprint-status.yaml --epics _bmad-output/planning-artifacts/epics.md",
    "gate:impl1": "npm run typecheck && npm run test:lint-rules && npm run gate:api:solu2 && npm run gate:ui:solu2 && npm run gate:codes:solu2 && npm run gate:ids:solu2 && npm run gate:trace:solu2 && npm run gate:epics:solu2 && npm run gate:purity && npm run test:fitness:solu2 && npm run gate:atdd-red:impl1 && npm run gate:nfr-red:impl1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "fast-check": "4.10.2",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@trpc/server": "11.19.0",
    "better-auth": "1.7.7",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  }
}
