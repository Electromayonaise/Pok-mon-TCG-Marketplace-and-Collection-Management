# Copy to .env for local runs outside Docker (`cp .env.example .env`). docker-compose.yml sets
# its own values for the app container. Every variable is validated at start-up
# (src/shared-kernel/config.ts); a missing or malformed one stops the app with its name.

# The app database. Its server is the Compose Postgres (`npm run db:up`); `npm run db:migrate`
# creates the database and applies the migrations. The tests never use it: each test file gets
# its own database cloned from a template.
DATABASE_URL=postgresql://tezg:tezg@127.0.0.1:55432/tezg_dev

# Better Auth: the secret signs session cookies (at least 32 characters; generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`), and the URL
# is the origin the app is served from.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
BETTER_AUTH_URL=http://localhost:3000

# S-7: caller IPs are stored only as HMAC-SHA256 under this key (at least 32 characters; generate it like
# the secret above). The contact handoff's per-IP limit counts these values; never log the key.
IP_HMAC_KEY=change-me-to-another-random-string-of-32-or-more-characters

# S-9: the bearer every scheduled job call sends (`Authorization: Bearer <JOBS_SECRET>` on
# POST /api/jobs/<job>?trigger=tick|daily-morning|daily-night). At least 32 characters; the
# scheduler (GitHub Actions, Vercel Cron) holds the same value. Never log it.
JOBS_SECRET=change-me-to-a-third-random-string-of-32-or-more-characters

# The runtime pg pool's size (AD-SYS-4 rules 7 and 9, ARCHITECTURE §4): a whole number from 2 to 50, 2 when
# unset. 2 is the minimum, since a scheduled job holds its lock on one connection while its work runs on a
# second; serverless instances (Vercel) keep it. A long-lived server, where one process serves every request,
# raises it: docker-compose.yml, `npm run nfr:k6` and `npx playwright test` set 10. The Postgres server (or
# the Supabase pooler) must allow every instance's pool at once.
TEZG_PG_POOL_MAX=2
